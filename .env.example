# Copy this file to `.env` and paste your keys after the `=` signs.
# `.env` is git-ignored and never leaves your machine.

# --- Sprint 2 ---
# The Guardian Open Platform — https://open-platform.theguardian.com/access/
# Free, 5,000 calls/day. Arrives by email, usually within a minute.
GUARDIAN_API_KEY=

# NewsData.io — https://newsdata.io/register
# Free, 200 credits/day. Shown on your dashboard immediately after signup.
NEWSDATA_API_KEY=

# --- Sprint 3 (not needed yet) ---
# Google AI Studio — https://aistudio.google.com/
GEMINI_API_KEY=

# --- Sprint 4 (not needed yet) ---
# Gmail app password — https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
BRIEFING_RECIPIENT=
